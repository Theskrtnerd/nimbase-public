{
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [".", "src/app/.well-known/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "public"]
}
