{
  "name": "@acme/nextjs",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:prod": "pnpm with-env:prod next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --port 3100",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start --port 3100",
    "start:prod": "pnpm with-env:prod next start --port 3100",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "with-env": "infisical run --env dev --",
    "with-env:prod": "dotenv -e ../../.env.production --"
  },
  "dependencies": {
    "@acme/agents": "workspace:*",
    "@acme/api": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/mdx": "workspace:*",
    "@acme/runtime": "workspace:*",
    "@acme/ui": "workspace:*",
    "@acme/validators": "workspace:*",
    "@ai-sdk/react": "^4.0.12",
    "@clerk/mcp-tools": "^0.5.0",
    "@clerk/nextjs": "^7.3.5",
    "@langfuse/otel": "^5.9.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@nimbase/connector-sdk": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "@upstash/qstash": "^2.11.0",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.11",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^1.1.0",
    "motion": "^12.38.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
