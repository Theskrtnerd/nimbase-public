{
  "name": "@acme/runtime",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./src/s3.ts"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./src/ai/index.ts"
    },
    "./artifact-build": {
      "types": "./dist/artifact-build.d.ts",
      "default": "./src/artifact-build.ts"
    },
    "./artifact-mermaid": {
      "types": "./dist/artifact-mermaid.d.ts",
      "default": "./src/artifact-mermaid.ts"
    },
    "./artifact-theme": {
      "types": "./dist/artifact-theme.d.ts",
      "default": "./src/artifact-theme.ts"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./src/queue.ts"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./src/env.ts"
    },
    "./chunk": {
      "types": "./dist/chunk.d.ts",
      "default": "./src/chunk.ts"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./src/embed.ts"
    },
    "./index-node-version": {
      "types": "./dist/index-node-version.d.ts",
      "default": "./src/index-node-version.ts"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./src/search.ts"
    },
    "./knowledge-graph": {
      "types": "./dist/knowledge-graph.d.ts",
      "default": "./src/knowledge-graph.ts"
    },
    "./graph-scan": {
      "types": "./dist/graph-scan.d.ts",
      "default": "./src/graph-scan.ts"
    },
    "./memory/wiki-pg-provider": {
      "types": "./dist/memory/wiki-pg-provider.d.ts",
      "default": "./src/memory/wiki-pg-provider.ts"
    },
    "./memory/wiki": {
      "types": "./dist/memory/wiki/index.d.ts",
      "default": "./src/memory/wiki/index.ts"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./src/memory/index.ts"
    },
    "./memory/git-history": {
      "types": "./dist/memory/git-history.d.ts",
      "default": "./src/memory/git-history.ts"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./src/harness/index.ts"
    },
    "./biographer": {
      "types": "./dist/biographer.d.ts",
      "default": "./src/biographer.ts"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./src/html.ts"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./src/normalize.ts"
    },
    "./raw-md": {
      "types": "./dist/raw-md.d.ts",
      "default": "./src/raw-md.ts"
    },
    "./safe-http": {
      "types": "./dist/safe-http.d.ts",
      "default": "./src/safe-http.ts"
    },
    "./artifact-runtime": {
      "types": "./dist/artifact-runtime.d.ts",
      "default": "./src/artifact-runtime.ts"
    }
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:baseline": "EVAL_UPDATE_BASELINE=1 vitest run --config vitest.eval.config.ts",
    "eval:refresh": "tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/memory/evals/refresh-embeddings.ts",
    "migrate:okf-datasets": "tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/scripts/migrate-okf-datasets.ts",
    "reproject:okf": "tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/scripts/reproject-okf.ts",
    "project:memory-git-history": "infisical run --env dev -- tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/scripts/project-memory-git-history.ts",
    "project:memory-git-history:prod": "infisical run --env prod -- tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/scripts/project-memory-git-history.ts",
    "eval:refresh:real": "infisical run --env dev -- tsx --import ./src/memory/evals/register-tsx-hooks.mjs src/memory/evals/refresh-embeddings.ts --real",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@acme/agents": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/mdx": "workspace:*",
    "@ai-sdk/harness": "^1.0.14",
    "@ai-sdk/harness-pi": "^1.0.14",
    "@ai-sdk/openai-compatible": "^3.0.3",
    "@ai-sdk/sandbox-just-bash": "^1.0.14",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@upstash/qstash": "^2.11.0",
    "ai": "^7.0.11",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "gray-matter": "^4.0.3",
    "just-bash": "^2.14.5",
    "server-only": "^0.0.1",
    "sucrase": "^3.35.1",
    "undici": "^8.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.5",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "prettier": "@acme/prettier-config"
}
